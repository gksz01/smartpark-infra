# Prefira executar node scripts/init-local.mjs para gerar segredos e conexão válidos.
JWT_SECRET=generate-a-random-secret
INTERNAL_API_KEY=generate-another-random-secret
SQL_PASSWORD=generate-a-strong-sql-password
ADMIN_EMAIL=admin@smartpark.test
ADMIN_PASSWORD=generate-a-strong-admin-password
AZURITE_ACCOUNTS=smartpark:replace-with-base64-key
LOCAL_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=http;AccountName=smartpark;AccountKey=replace-with-base64-key;BlobEndpoint=http://azurite:10000/smartpark;QueueEndpoint=http://azurite:10001/smartpark;TableEndpoint=http://azurite:10002/smartpark;
